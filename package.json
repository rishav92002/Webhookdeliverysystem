{
  "name": "webhookdeliverysystem",
  "version": "1.0.0",
  "description": "This is a webhook delivery system",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:outbox-worker": "cross-env NODE_ENV=development tsx watch src/workers/index.ts",
    "start:delivery-publisher": "cross-env NODE_ENV=development tsx watch src/publishers/deliveryPublisher/index.ts",
    "start:delivery-worker": "cross-env NODE_ENV=development tsx watch src/workers/deliveryWorker/index.ts",
    "start:all": "cross-env NODE_ENV=development concurrently -k -n api,outbox,publisher,worker -c blue,green,yellow,magenta \"npm run dev\" \"npm run start:outbox-worker\" \"npm run start:delivery-publisher\" \"npm run start:delivery-worker\"",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "start:prod:outbox-worker": "cross-env NODE_ENV=production node dist/workers/index.js",
    "start:prod:delivery-publisher": "cross-env NODE_ENV=production node dist/publishers/deliveryPublisher/index.js",
    "start:prod:delivery-worker": "cross-env NODE_ENV=production node dist/workers/deliveryWorker/index.js",
    "start:prod:all": "cross-env NODE_ENV=production concurrently -k -n api,outbox,publisher,worker -c blue,green,yellow,magenta \"npm run start:prod\" \"npm run start:prod:outbox-worker\" \"npm run start:prod:delivery-publisher\" \"npm run start:prod:delivery-worker\"",
    "test:api": "cross-env NODE_ENV=development tsx src/mock/runApiTests.ts",
    "test:redis": "cross-env NODE_ENV=development tsx src/lib/redistest.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.18.1",
    "bullmq": "^5.81.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
